{
    "dataset": "Iris",
    "description": "Contrato de datos para el modelo de clasificación Iris",

    "features": {
        "sepal length (cm)": {
            "type": "float",
            "min": 4.0,
            "max": 8.0
        },
        "sepal width (cm)": {
            "type": "float",
            "min": 2.0,
            "max": 5.0
        },
        "petal length (cm)": {
            "type": "float",
            "min": 1.0,
            "max": 7.0
        },
        "petal width (cm)": {
            "type": "float",
            "min": 0.1,
            "max": 3.0
        }
    },

    "target": {
        "name": "species",
        "type": "integer",
        "allowed_values": [0, 1, 2]
    },

    "null_values_allowed": false,

    "valid_example": {
        "sepal length (cm)": 5.1,
        "sepal width (cm)": 3.5,
        "petal length (cm)": 1.4,
        "petal width (cm)": 0.2
    },

    "invalid_example": {
        "sepal length (cm)": 5.1,
        "sepal width (cm)": 3.5,
        "petal length (cm)": 1.4,
        "petal width (cm)": 3.5 
    }
}